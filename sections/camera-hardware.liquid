    ]},
    {n:'Binnensirene', type:'Sensor', koop:90.00, huur:2.88, huurSku:'H018', k:'binnensirene', sku:'CL006A'},
    {n:'Koolmonoxidemelder', type:'Sensor', koop:90.00, huur:2.88, huurSku:'H0013', k:'koolmonoxidemelder', sku:'CL008', desc:[
      'Koolmonoxide, ook bekend als CO, staat niet voor niets bekend als sluipmoordenaar. U ziet of ruikt het niet, maar wanneer u het inademt, kan dit ernstige lichamelijke gevolgen hebben.',
      'De CO-detector levert 24/7 bescherming van u en uw familie door de detectie van het gevaarlijke koolstofmonoxide (CO) in uw woning. De elektrochemische CO-sensor is in staat om reeds zeer lage monoxide-niveaus (tot 30ppm) te detecteren en een alarm door te sturen naar de centrale, waarna u direct via de app een bericht ontvangt met de melding, uw alarm gaat af en, indien u heeft gekozen om uw beveiligingssysteem te koppelen aan de meldkamer van Securitas, dan ontvangen zij ook direct een melding en komen in actie.'
    ]},
    {n:'Paniek wandschakelaar HELP', type:'Sensor', koop:60.00, huur:1.92, huurSku:'H0007', k:'paniek_wandschakelaar', sku:'CL013', desc:[
      'Hoort u een verdacht geluid en voelt u zich niet veilig, dan kunt u op discrete manier hulp inroepen. Met een simpele druk op de knop stelt u bij gevaar of paniek een stil alarm in werking.',
      'Bent u aangesloten op de meldkamer, dan zal Securitas direct in actie komen en contact met u en uw naasten opnemen, tevens zullen wij, door het inschatten van de situatie, schakelen met de hulpdiensten. Kiest u ervoor om uw beveiligingssysteem niet aan te sluiten op de meldkamer, dan worden alleen de mensen ingelicht die u zelf heeft aangemeld in de app of de portal. Onze monteur helpt u er graag bij om de instellingen goed voor u in orde te maken.'
    ]},
    {n:'Paniekknop PB 15 klein', type:'Sensor', koop:60.00, huur:1.92, huurSku:'H0008', k:'paniekknop_pb15', sku:'CL014'},
    {n:'Paniekhorloge', type:'Sensor', koop:60.00, huur:1.92, huurSku:'H0009', k:'paniekhorloge', sku:'CL015'},
    {n:'Hittemelder', type:'Sensor', koop:75.00, huur:2.40, huurSku:'H0012', k:'hittemelder', sku:'CL016', desc:[
      'Alle nieuwbouwwoningen zijn tegenwoordig voorzien van rookmelders. Rookmelders geven een luid alarm wanneer er rook wordt gedetecteerd. Helaas is het niet altijd mogelijk om een rookmelder te gebruiken, bijvoorbeeld in stoffige ruimtes. Een hittemelder is hier vaak de oplossing. Een hittemelder is een brandmelder die warmte detecteert in plaats van rook om u te waarschuwen bij brand. Een hittemelder wordt toegepast in ruimtes waar damp, stof of gassen ervoor zorgen dat een rookmelder vals alarm zou slaan, zoals: keukens, garages, natte ruimtes.',
      'Bij het maken van de keuze tussen een rookmelder en een hittemelder moet u met een aantal factoren rekening houden. De ruimte waarin u een brandalarm wilt plaatsen bepaalt het type alarm dat het meest geschikt is. Een hittemelder, ook wel thermische brandmelder genoemd, slaat alarm wanneer deze een snelle temperatuurstijging constateert, doorgaans rond de 58 graden Celsius. Door een rookmelder te combineren met een hittemelder in de ruimtes waar dat nodig is zorgt u voor optimale veiligheid in huis.'
    ]},
    {n:'Watersensor', type:'Sensor', koop:45.00, huur:1.44, huurSku:'H0014', k:'watersensor', sku:'CL020'},
    {n:'Rook- en koolmonoxidemelder', type:'Sensor', koop:150.00, huur:4.79, huurSku:'H0045', k:'rook_en_koolmonoxidemelder', sku:'CL102'},
    {n:'Roldeurmagneetcontact (behuizing + magneetcontact)', type:'Accessoire', koop:129.00, huur:3.16, huurSku:'H0071', k:'roldeur_behuizing', sku:'ROL'}
  ];
  var state={ lines:{}, filter:'', open:{} };
  function euro(n){ return '€ '+Number(n).toFixed(2).replace('.',','); }

  var SRC=['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','fbclid'];
  function captureSource(){
    var store={}; try{ store=JSON.parse(sessionStorage.getItem('zv_src')||'{}'); }catch(e){}
    var qs=new URLSearchParams(location.search);
    SRC.forEach(function(k){ var v=qs.get(k); if(v) store[k]=v; });
    if(qs.get('pakket')) store.pakket_intent=qs.get('pakket');
    try{ sessionStorage.setItem('zv_src',JSON.stringify(store)); }catch(e){}
    var out={}; SRC.forEach(function(k){ out[k]=store[k]||''; });
    out.pakket_intent=store.pakket_intent||'';
    out.landing_page=location.pathname+location.search; out.referrer=document.referrer;
    return out;
  }
  captureSource();

  /* Filter categories: the row's type split on "+" ("Binnen+Buiten" is both), plus meldkamer
     for rows flagged meldkamer:true. Only what the HW data says; nothing is inferred. */
  function catsOf(h){ var c=h.type.toLowerCase().split('+'); if(h.meldkamer) c.push('meldkamer'); return c; }
  var ICON={
    cam:'<svg viewBox="0 0 24 24" fill="none"><path d="M3 8.5h4l1.5-2.5h7L17 8.5h4v11H3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="14" r="3.4" stroke="currentColor" stroke-width="1.6"/></svg>',
    bel:'<svg viewBox="0 0 24 24" fill="none"><rect x="7" y="2.5" width="10" height="19" rx="3" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="8" r="2.2" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="15.5" r="1.8" stroke="currentColor" stroke-width="1.6"/></svg>',
    rec:'<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 12h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="17" cy="12" r="1.2" fill="currentColor"/></svg>',
    sensor:'<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M7.8 7.8a6 6 0 0 0 0 8.4M16.2 7.8a6 6 0 0 1 0 8.4M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
    acc:'<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="3" width="14" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M9 8h6M9 12h6M9 16h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
  };
  function iconFor(h){
    if(h.type==='Deurbel') return ICON.bel;
    if(h.type==='Recorder') return ICON.rec;
    if(h.type==='Sensor') return ICON.sensor;
    if(h.type==='Accessoire') return ICON.acc;
    return ICON.cam;
  }

  function modeChip(h,mode){
    var l=state.lines[h.k], on=l&&l.mode===mode;
    var price=euro(mode==='koop'?h.koop:h.huur);
    var lab=mode==='koop'?'Kopen':'Huren', unit=mode==='koop'?'eenmalig':'per maand';
    return '<button type="button" class="modechip '+mode+(on?' on':'')+'" data-mode="'+mode+'" aria-pressed="'+(on?'true':'false')+'"><span class="ml">'+lab+'</span><span class="mp">'+price+'</span><span class="mu">'+unit+'</span></button>';
  }
  function specHtml(h){
    var desc=h.desc?'<div class="hw-desc">'+h.desc.map(function(p){ return '<p>'+p+'</p>'; }).join('')+'</div>':'';
    if(!h.specs) return desc;
    var model=h.model?'<div class="hw-spec-model">'+h.model+'</div>':'';
    var rows=h.specs.map(function(s){
      return '<div class="hw-spec-row"><span class="hw-spec-l">'+s[0]+'</span><span class="hw-spec-v">'+s[1]+'</span></div>';
    }).join('');
    return desc+model+'<div class="hw-spec-list">'+rows+'</div>';
  }
  /* Two groups, split on h.huur: rows with a huur price offer Kopen and Huren, the rest are
     koop-only (one chip, no "binnenkort" Huren). Array order is kept within each group. Each
     card shows the first three spec rows of a row that has specs; the toggle opens the full
     specs and/or desc ("Meer info" when there's only desc). */
  var GROUPS=[
    {title:'Onze hardware — kopen of huren', huur:true},
    {title:'Extra sensoren & accessoires — eenmalig te koop', huur:false}
  ];
  function rowEl(h){
    var l=state.lines[h.k], q=l?l.qty:0, hasMode=!!(l&&l.mode), open=!!state.open[h.k];
    var chosenSku=hasMode&&l.mode==='huur'&&h.huurSku?h.huurSku:h.sku;
    var chosen=hasMode?'<span class="hw-chosen">Gekozen: '+(l.mode==='koop'?'Kopen · eenmalig':'Huren · maandelijks')+' &middot; '+chosenSku+'</span>':'';
    var specsId='specs-'+h.k;
    var hasInfo=!!(h.specs||h.desc);
    var key=h.specs?'<dl class="hw-key">'+h.specs.slice(0,3).map(function(s){ return '<div><dt>'+s[0]+'</dt><dd>'+s[1]+'</dd></div>'; }).join('')+'</dl>':'';
    var specBtn=hasInfo?'<button type="button" class="hw-spec-btn" aria-expanded="'+(open?'true':'false')+'" aria-controls="'+specsId+'">'+(h.specs?'Alle specificaties':'Meer info')+'<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>':'';
    var specPanel=hasInfo?'<div class="hw-specs" id="'+specsId+'" role="region"'+(open?' style="max-height:none"':'')+'><div class="hw-specs-in">'+specHtml(h)+'</div></div>':'';
    var el=document.createElement('article'); el.className='hw'+(q>0?' has':'')+(open?' specs-open':''); el.setAttribute('data-k',h.k);
    el.innerHTML=
      '<div class="hw-media" aria-hidden="true">'+iconFor(h)+'<span class="hw-type">'+h.type.replace('+',' / ')+'</span></div>'+
      '<h3 class="hw-name">'+h.n+'</h3>'+
      (h.model?'<div class="hw-model">'+h.model+'</div>':'')+
      key+specBtn+specPanel+
      '<div class="hw-buy">'+
        '<div class="hw-modes">'+modeChip(h,'koop')+(h.huur!=null?modeChip(h,'huur'):'')+'</div>'+
        '<div class="stepper"><button type="button" data-d="-1" aria-label="Eén minder"'+(q===0?' disabled':'')+'>−</button><span class="q">'+q+'</span><button type="button" data-d="1" aria-label="Eén meer"'+(hasMode?'':' disabled')+'>+</button></div>'+
        chosen+
      '</div>';
    return el;
  }
  function renderRows(){
    var rows=document.getElementById('rows'); rows.innerHTML='';
    GROUPS.forEach(function(g){
      var list=HW.filter(function(h){ return (h.huur!=null)===g.huur && (!state.filter || catsOf(h).indexOf(state.filter)>-1); });
      if(!list.length) return;
      var head=document.createElement('h3'); head.className='hw-group-h'; head.textContent=g.title;
      var grid=document.createElement('div'); grid.className='hw-grid';
      list.forEach(function(h){ grid.appendChild(rowEl(h)); });
      rows.appendChild(head); rows.appendChild(grid);
    });
  }
  document.getElementById('rows').addEventListener('click',function(e){
    var specBtn=e.target.closest('.hw-spec-btn');
    if(specBtn){
      var hwEl=specBtn.closest('.hw'), panel=hwEl.querySelector('.hw-specs');
      var open=hwEl.classList.toggle('specs-open');
      state.open[hwEl.getAttribute('data-k')]=open;
      specBtn.setAttribute('aria-expanded', open?'true':'false');
      panel.style.maxHeight=panel.scrollHeight+'px';
      if(!open){ panel.offsetHeight; panel.style.maxHeight='0'; }
      return;
    }
    var chip=e.target.closest('.modechip');
    if(chip){
      var k=chip.closest('.hw').getAttribute('data-k'), m=chip.getAttribute('data-mode');
      var l=state.lines[k]||{mode:null,qty:0}; l.mode=m; if(l.qty<1) l.qty=1; state.lines[k]=l;
      renderRows(); renderSummary(); return;
    }
    var btn=e.target.closest('button[data-d]'); if(!btn) return;
    var k=btn.closest('.hw').getAttribute('data-k'), l=state.lines[k], d=parseInt(btn.getAttribute('data-d'),10);
    if(d>0 && (!l||!l.mode)) return;
    l=l||{mode:null,qty:0}; l.qty+=d;
    if(l.qty<=0) delete state.lines[k]; else state.lines[k]=l;
    renderRows(); renderSummary();
  });

  // Filter chips: count per category from the HW data; a chip with no match is hidden.
  var filters=scope.querySelector('.ch-filters');
  filters.querySelectorAll('[data-filter]').forEach(function(b){
    var f=b.getAttribute('data-filter');
    var n=f?HW.filter(function(h){ return catsOf(h).indexOf(f)>-1; }).length:HW.length;
    b.querySelector('.n').textContent=n;
    if(!n) b.hidden=true;
  });
  filters.addEventListener('click',function(e){
    var b=e.target.closest('[data-filter]'); if(!b) return;
    state.filter=b.getAttribute('data-filter');
    filters.querySelectorAll('[data-filter]').forEach(function(x){
      var on=x===b; x.classList.toggle('on',on); x.setAttribute('aria-pressed',on?'true':'false');
    });
    renderRows();
  });

  function renderSummary(){
    var list=document.getElementById('sumList'), keys=Object.keys(state.lines);
    list.innerHTML='';
    var cams=0, items=0, koop=0, huur=0;
    keys.forEach(function(k){
      var h=HW.find(function(x){return x.k===k;}); var l=state.lines[k], q=l.qty;
      if(h.type!=='Recorder' && h.type!=='Sensor' && h.type!=='Accessoire') cams+=q;
      items+=q;
      var isKoop=l.mode==='koop', unit=isKoop?h.koop:h.huur, line=unit*q;
      if(isKoop) koop+=line; else huur+=line;
      list.insertAdjacentHTML('beforeend','<div class="sl"><span><span class="q">'+q+'×</span> '+h.n+' <em style="color:'+(isKoop?'var(--belt)':'var(--indigo-2)')+';font-style:normal;font-weight:800">('+(isKoop?'Kopen':'Huren')+')</em></span><span class="v">'+euro(line)+(isKoop?'':'/m')+'</span></div>');
    });
    document.getElementById('camCount').textContent=cams;
    document.getElementById('sumEmpty').style.display=keys.length?'none':'block';
    document.getElementById('sumBtn').disabled=!keys.length;
    document.getElementById('chBar').hidden=!keys.length;
    document.getElementById('chBarT').innerHTML='<b>'+items+'</b> '+(items===1?'product':'producten')+' &middot; '+euro(koop)+' eenmalig'+(huur?' &middot; '+euro(huur)+'/mnd':'');
    var tot=document.getElementById('sumTot');
    if(!keys.length){ tot.innerHTML=''; return; }
    tot.innerHTML=
      '<div class="tr big"><span>Totaal eenmalig</span><span class="accent" style="color:var(--belt)">'+euro(koop)+'</span></div>'+
      '<div class="tr muted"><span>Vandaag via iDEAL / creditcard</span></div>'+
      '<div class="tr big" style="margin-top:8px"><span>Totaal per maand</span><span class="accent">'+euro(huur)+'</span></div>'+
      '<div class="tr muted"><span>Maandelijks via SEPA-incasso</span></div>';
  }

  document.getElementById('sumBtn').addEventListener('click',function(){
    var keys=Object.keys(state.lines); if(!keys.length) return;
    var lines=keys.map(function(k){
      var h=HW.find(function(x){return x.k===k;}); var l=state.lines[k], isKoop=l.mode==='koop';
      return { sku:isKoop?h.sku:(h.huurSku||h.sku), key:k, name:h.n, type:h.type, mode:isKoop?'Kopen':'Huren',
        bucket:isKoop?'Eenmalig':'Maandelijks', unit:isKoop?h.koop:h.huur, qty:l.qty };
    });
    var payload={ lines:lines, source:captureSource() };
    try{ localStorage.setItem('zv_addons_intake', JSON.stringify(payload)); }catch(e){}
    window.location.href='tel:0881221111';
  });

  document.getElementById('camContact').addEventListener('submit', function(e){
    e.preventDefault();
    var name=document.getElementById('ccName').value.trim();
    var phone=document.getElementById('ccPhone').value.trim();
    var email=document.getElementById('ccEmail').value.trim();
    var consent=document.getElementById('ccConsent').checked;
    var err=document.getElementById('ccErr');
    if(!name || !phone){ err.textContent='Vul uw naam en telefoonnummer in.'; err.style.display='block'; return; }
    if(!consent){ err.textContent=this.getAttribute('data-consent-error'); err.style.display='block'; return; }
    err.style.display='none';
    /* The configured setup rides along so Odoo's Pakket/Prijs fields aren't blank: every line of
       state.lines in summary order, plus the Kopen and Huren totals. Nothing configured (a plain
       callback) sends null for all three, never empty strings. */
    var koop=0, huur=0;
    var setup=Object.keys(state.lines).map(function(k){
      var h=HW.find(function(x){return x.k===k;}); var l=state.lines[k], isKoop=l.mode==='koop';
      if(isKoop) koop+=h.koop*l.qty; else huur+=h.huur*l.qty;
      return l.qty+'x '+h.n+' ('+(isKoop?'Kopen':'Huren')+')';
    });
    var payload={ lead_type:'camerahardware', source_page:'camera-hardware', name:name, phone:phone, email:email||null,
      consent:consent, cta_location:'camera_hardware_page', source:captureSource(),
      item_name:setup.length?setup.join(', '):null, one_time_price:koop?euro(koop):null, monthly_price:huur?euro(huur):null };
    if (window.ZVLeadWebhook) { window.ZVLeadWebhook.send(payload, 'camera_hardware'); }
    try{ var leads=JSON.parse(localStorage.getItem('zv_leads')||'[]'); leads.push(payload); localStorage.setItem('zv_leads', JSON.stringify(leads)); }catch(ex){}
    /* #ccDone sits inside the form, so hide the fields, not the form, or the thank-you never shows. */
    Array.prototype.forEach.call(this.children, function(el){ if(el.id!=='ccDone') el.style.display='none'; });
    document.getElementById('ccDone').style.display='flex';
  });

  // FAQ accordion, same behaviour as the Veelgestelde vragen page.
  scope.querySelectorAll('.ch-faq .fq-item').forEach(function(it){
    var q=it.querySelector('.fq-q'), a=it.querySelector('.fq-a');
    q.addEventListener('click',function(){
      var open=it.classList.toggle('open');
      q.setAttribute('aria-expanded', open?'true':'false');
      a.style.maxHeight=open?a.scrollHeight+'px':'0';
    });
  });

  renderRows(); renderSummary();
})();
</script>

{% stylesheet %}
.zv-camera {
  --ink:#1a1230; --indigo:#322469; --indigo-2:#473a86; --indigo-soft:#efecf7;
  --cream:#fdfaf2; --paper:#fffdf8; --sand:#efe9d6; --sand-2:#e6dfca;
  --gold:#e4a311; --gold-lt:#f5c84a; --belt:#9c6c08;
  --rood:#c52e2f; --red:#e24b4a; --ok:#2f8f5b;
  --line:#e8e0cd; --line-2:#ded6c0; --muted:#6f6786; --muted-2:#8c84a6;
  color:var(--ink); line-height:1.5; background:linear-gradient(180deg,#fbf5e9,#f4ecda);
}
.zv-camera .wrap { max-width:1180px; margin:0 auto; padding:0 clamp(16px,3.4vw,48px); }
.zv-camera .topbar { background:var(--paper); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.zv-camera .topbar .wrap { display:flex; align-items:center; gap:9px; padding-top:13px; padding-bottom:13px; }
.zv-camera .crumb { font-size:13px; font-weight:600; color:var(--muted); display:flex; align-items:center; gap:8px; }
.zv-camera .crumb a { color:var(--indigo); font-weight:800; text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
.zv-camera .crumb a svg { width:15px; height:15px; }
.zv-camera .crumb .sep { color:var(--line-2); }
.zv-camera .crumb b { color:var(--indigo); font-weight:800; }
.zv-camera a:focus-visible, .zv-camera button:focus-visible { outline:2px solid var(--indigo); outline-offset:3px; }
.zv-camera .btn svg { width:17px; height:17px; }

/* Hero */
.zv-camera .ch-hero .wrap { padding-top:clamp(30px,4.4vw,56px); padding-bottom:clamp(26px,3.4vw,40px); }
.zv-camera .eyebrow { display:inline-flex; align-items:center; gap:8px; font-size:11.5px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; color:var(--rood); background:var(--paper); border:1px solid var(--line); border-radius:999px; padding:7px 14px; }
.zv-camera .eyebrow::before { content:""; width:7px; height:7px; border-radius:50%; background:var(--red); }
.zv-camera .ch-hero h1 { font-size:clamp(30px,4.4vw,48px); font-weight:900; letter-spacing:-.02em; line-height:1.04; color:var(--indigo); margin:16px 0 0; max-width:760px; }
.zv-camera .ch-hero p { font-size:16.5px; font-weight:600; color:var(--muted); margin:14px 0 0; max-width:640px; line-height:1.5; }
.zv-camera .ch-ctas { display:flex; flex-wrap:wrap; gap:12px; margin-top:24px; }

/* Trust strip */
.zv-camera .ch-trust { background:var(--paper); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.zv-camera .ch-trust ul { list-style:none; margin:0 auto; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px 22px; padding-top:16px; padding-bottom:16px; }
@media(max-width:860px){ .zv-camera .ch-trust ul { grid-template-columns:repeat(2,minmax(0,1fr)); } }
.zv-camera .ch-trust li { display:flex; align-items:center; gap:9px; font-size:14px; font-weight:800; color:var(--indigo); line-height:1.3; }
.zv-camera .ch-trust li svg { width:18px; height:18px; flex:none; color:var(--ok); }
.zv-camera .ch-trust a { color:inherit; text-decoration:underline; text-decoration-color:var(--line-2); text-underline-offset:3px; }
.zv-camera .ch-trust a:hover { text-decoration-color:currentColor; }

/* Shop: filters + grid */
.zv-camera .ch-shop { padding-top:clamp(30px,3.6vw,46px); scroll-margin-top:132px; }
.zv-camera .cat-head { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:14px; }
.zv-camera .cat-head h2 { font-size:clamp(21px,2.4vw,28px); font-weight:900; color:var(--indigo); letter-spacing:-.015em; margin:0; }
.zv-camera .cat-hint { margin-left:auto; font-size:12.5px; font-weight:700; color:var(--muted); display:inline-flex; align-items:center; gap:7px; }
.zv-camera .cat-hint svg { width:15px; height:15px; color:var(--belt); }
@media(max-width:680px){ .zv-camera .cat-hint { margin-left:0; } }
.zv-camera .ch-filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:22px; }
.zv-camera .ch-chip { font-family:inherit; font-size:13.5px; font-weight:800; color:var(--indigo); background:#fff; border:1.5px solid var(--line-2); border-radius:999px; padding:9px 15px; cursor:pointer; display:inline-flex; align-items:center; gap:7px; transition:border-color .14s,background .14s,color .14s; }
.zv-camera .ch-chip:hover { border-color:var(--indigo); }
.zv-camera .ch-chip .n { font-size:11.5px; font-weight:800; color:var(--muted); background:var(--cream); border-radius:999px; padding:1px 7px; }
.zv-camera .ch-chip.on { background:var(--indigo); border-color:var(--indigo); color:#fff; }
.zv-camera .ch-chip.on .n { background:rgba(255,255,255,.18); color:#fff; }
.zv-camera .ch-chip[hidden] { display:none; }
.zv-camera .hw-group-h { font-size:17px; font-weight:900; color:var(--indigo); letter-spacing:-.01em; line-height:1.2; margin:0 0 12px; }
.zv-camera .hw-grid + .hw-group-h { margin-top:30px; }
.zv-camera .hw-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
@media(max-width:980px){ .zv-camera .hw-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:620px){ .zv-camera .hw-grid { grid-template-columns:1fr; } }
.zv-camera .hw { display:flex; flex-direction:column; gap:10px; min-width:0; background:var(--paper); border:1.5px solid var(--line); border-radius:16px; padding:12px 12px 16px; transition:border-color .14s,box-shadow .14s; }
.zv-camera .hw.has { border-color:var(--indigo); box-shadow:0 10px 26px -18px rgba(50,36,105,.6); }
.zv-camera .hw-media { position:relative; aspect-ratio:5/2; border-radius:11px; background:linear-gradient(135deg,var(--indigo-soft),#f6f1e3); display:grid; place-items:center; color:var(--indigo); }
.zv-camera .hw-media svg { width:46px; height:46px; opacity:.8; }
.zv-camera .hw-type { position:absolute; top:10px; left:10px; font-size:10.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--indigo); background:#fff; border-radius:999px; padding:4px 9px; }
.zv-camera .hw-name { font-size:16px; font-weight:800; color:var(--ink); line-height:1.25; margin:4px 4px 0; }
.zv-camera .hw-model { font-size:11px; font-weight:800; letter-spacing:.02em; text-transform:uppercase; color:var(--muted); margin:-4px 4px 0; }
.zv-camera .hw-key { margin:0 4px; display:flex; flex-direction:column; gap:4px; }
.zv-camera .hw-key div { display:grid; grid-template-columns:82px 1fr; gap:8px; font-size:12.5px; line-height:1.4; }
.zv-camera .hw-key dt { color:var(--muted); font-weight:700; }
.zv-camera .hw-key dd { margin:0; color:#3a3550; font-weight:600; overflow-wrap:anywhere; }
.zv-camera .hw-spec-btn { align-self:flex-start; display:inline-flex; align-items:center; gap:4px; font-family:inherit; font-size:12px; font-weight:800; color:var(--indigo); background:none; border:none; padding:2px 4px; cursor:pointer; }
.zv-camera .hw-spec-btn svg { width:12px; height:12px; transition:transform .16s; }
.zv-camera .hw-spec-btn[aria-expanded="true"] svg { transform:rotate(180deg); }
.zv-camera .hw-specs { max-height:0; overflow:hidden; transition:max-height .2s ease; margin:0 4px; }
.zv-camera .hw-specs-in { padding-top:10px; border-top:1px solid var(--line); }
.zv-camera .hw-desc p { font-size:12.5px; font-weight:500; line-height:1.55; color:#3a3550; margin:0 0 8px; }
.zv-camera .hw-desc + .hw-spec-model { margin-top:12px; }
.zv-camera .hw-spec-model { font-size:11px; font-weight:800; letter-spacing:.02em; text-transform:uppercase; color:var(--muted); margin-bottom:8px; }
.zv-camera .hw-spec-list { display:flex; flex-direction:column; gap:6px; }
.zv-camera .hw-spec-row { display:flex; flex-direction:column; gap:1px; font-size:12.5px; font-weight:600; color:#3a3550; }
.zv-camera .hw-spec-l { color:var(--muted); font-weight:700; }
.zv-camera .hw-buy { margin-top:auto; padding:6px 4px 0; display:flex; flex-direction:column; gap:10px; }
.zv-camera .hw-modes { display:flex; gap:8px; }
.zv-camera .modechip { flex:1 1 0; min-width:0; display:flex; flex-direction:column; align-items:flex-start; gap:1px; font-family:inherit; border:1.5px solid var(--line-2); background:#fff; border-radius:11px; padding:7px 12px; text-align:left; cursor:pointer; transition:border-color .14s,background .14s,box-shadow .14s; }
.zv-camera .modechip:hover { border-color:#c9bda0; }
.zv-camera .modechip .ml { font-size:10.5px; font-weight:800; letter-spacing:.03em; text-transform:uppercase; color:var(--muted); }
.zv-camera .modechip .mp { font-size:16px; font-weight:900; color:var(--ink); line-height:1.15; }
.zv-camera .modechip .mu { font-size:10.5px; font-weight:700; color:var(--muted); }
.zv-camera .modechip.on { border-color:var(--indigo); background:var(--indigo-soft); box-shadow:0 8px 20px -14px rgba(50,36,105,.7); }
.zv-camera .modechip.on .ml { color:var(--indigo); }
.zv-camera .modechip.on .mp { color:var(--indigo); }
.zv-camera .modechip.koop.on { border-color:var(--belt); background:#fbf1e0; }
.zv-camera .modechip.koop.on .ml, .zv-camera .modechip.koop.on .mp { color:var(--belt); }
.zv-camera .stepper { align-self:flex-start; display:inline-flex; align-items:center; border:1.5px solid var(--line-2); border-radius:11px; overflow:hidden; background:#fff; }
.zv-camera .stepper button { width:38px; height:40px; border:none; background:#fff; color:var(--indigo); font-size:20px; font-weight:800; line-height:1; display:grid; place-items:center; cursor:pointer; }
.zv-camera .stepper button:disabled { color:var(--line-2); cursor:default; }
.zv-camera .stepper button:hover:not(:disabled) { background:var(--indigo-soft); }
.zv-camera .stepper .q { min-width:34px; text-align:center; font-size:15px; font-weight:900; color:var(--ink); }
.zv-camera .hw-chosen { display:block; font-size:11px; font-weight:800; color:var(--ok); }

/* Sticky setup bar: shown once something is chosen, settles above Uw camera-setup. Right-
   aligned so it clears the contact FAB (bottom-left, assets/zv-contact-fab.css); below 960px
   the two don't fit side by side, so the bar sits above the FAB (96px tall, 72px <=600px). */
.zv-camera .ch-bar { position:sticky; bottom:calc(20px + env(safe-area-inset-bottom, 0px)); z-index:5; display:flex; justify-content:flex-end; padding:0 20px; margin-top:24px; pointer-events:none; }
@media(max-width:960px){ .zv-camera .ch-bar { bottom:calc(128px + env(safe-area-inset-bottom, 0px)); } }
@media(max-width:600px){ .zv-camera .ch-bar { bottom:calc(100px + env(safe-area-inset-bottom, 0px)); padding:0 16px; } }
.zv-camera .ch-bar[hidden] { display:none; }
.zv-camera .ch-bar-in { pointer-events:auto; display:flex; align-items:center; gap:14px; max-width:100%; background:var(--indigo); color:#fff; border-radius:999px; padding:8px 8px 8px 18px; box-shadow:0 18px 40px -18px rgba(26,18,48,.7); }
.zv-camera .ch-bar-t { font-size:13.5px; font-weight:700; }
.zv-camera .ch-bar-t b { font-weight:900; }
.zv-camera .ch-bar a { flex:none; font-size:13.5px; font-weight:800; color:var(--ink); background:var(--gold); border-radius:999px; padding:9px 15px; text-decoration:none; }
@media(max-width:620px){ .zv-camera .ch-bar-in { gap:10px; padding-left:14px; } .zv-camera .ch-bar-t { font-size:12.5px; } }

/* Uw camera-setup: summary + callback */
.zv-camera .ch-setup { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); gap:20px; align-items:start; padding-top:clamp(28px,3.4vw,40px); scroll-margin-top:132px; }
@media(max-width:860px){ .zv-camera .ch-setup { grid-template-columns:1fr; } }
.zv-camera .summary, .zv-camera .cam-contact { background:var(--paper); border:1px solid var(--line); border-radius:18px; padding:22px; box-shadow:0 26px 56px -42px rgba(26,18,48,.5); }
.zv-camera .summary h2 { font-size:clamp(19px,2.2vw,24px); font-weight:900; color:var(--indigo); letter-spacing:-.015em; margin:0; }
.zv-camera .sum-cams { display:flex; align-items:center; gap:10px; margin-top:14px; background:var(--cream); border:1px solid var(--line-2); border-radius:13px; padding:12px 14px; }
.zv-camera .sum-cams .ci { width:34px; height:34px; border-radius:10px; background:#fff; display:grid; place-items:center; flex:none; box-shadow:inset 0 0 0 1px var(--line-2); }
.zv-camera .sum-cams .ci svg { width:19px; height:19px; color:var(--indigo); }
.zv-camera .sum-cams b { font-size:21px; font-weight:900; color:var(--ink); line-height:1; }
.zv-camera .sum-cams span { font-size:12px; font-weight:700; color:var(--muted); display:block; margin-top:2px; }
.zv-camera .sum-list { margin-top:14px; display:flex; flex-direction:column; gap:8px; max-height:260px; overflow:auto; }
.zv-camera .sum-list .sl { display:flex; justify-content:space-between; gap:10px; font-size:13px; font-weight:600; color:#3a3550; }
.zv-camera .sum-list .sl .q { color:var(--muted); font-weight:800; }
.zv-camera .sum-list .sl .v { font-weight:800; white-space:nowrap; }
.zv-camera .sum-empty { font-size:13px; font-weight:600; color:var(--muted-2); margin-top:14px; line-height:1.5; }
.zv-camera .sum-tot { border-top:1.5px solid var(--line); margin-top:14px; padding-top:14px; display:flex; flex-direction:column; gap:7px; }
.zv-camera .sum-tot:empty { display:none; }
.zv-camera .sum-tot .tr { display:flex; justify-content:space-between; font-size:13.5px; font-weight:700; color:#3a3550; }
.zv-camera .sum-tot .tr.big { font-size:17px; font-weight:900; color:var(--ink); }
.zv-camera .sum-tot .tr.big .accent { color:var(--indigo); }
.zv-camera .sum-tot .muted { font-size:12px; font-weight:600; color:var(--muted-2); }
.zv-camera .sumbtn { margin-top:16px; width:100%; font-family:inherit; font-weight:800; font-size:15.5px; border:none; border-radius:13px; padding:15px; display:inline-flex; align-items:center; justify-content:center; gap:9px; background:var(--gold); color:var(--ink); box-shadow:0 2px 0 var(--belt); transition:transform .14s,box-shadow .14s; cursor:pointer; }
.zv-camera .sumbtn:hover { transform:translateY(-1px); box-shadow:0 4px 0 var(--belt),0 12px 24px -12px rgba(180,126,10,.7); }
.zv-camera .sumbtn:disabled { background:var(--sand); color:var(--muted-2); box-shadow:none; cursor:default; transform:none; }
.zv-camera .sumbtn svg { width:18px; height:18px; }
.zv-camera .sum-note { display:flex; align-items:center; gap:8px; justify-content:center; font-size:12px; font-weight:700; color:var(--muted); margin-top:11px; text-align:center; }
.zv-camera .sum-note svg { width:14px; height:14px; color:var(--ok); flex:none; }
.zv-camera .cam-contact { display:flex; flex-direction:column; gap:9px; }
.zv-camera .cam-contact-h { font-size:15px; font-weight:900; color:var(--indigo); margin-bottom:2px; }
.zv-camera .cam-contact input { font-family:inherit; font-size:13.5px; font-weight:600; color:var(--ink); border:1.5px solid var(--line); border-radius:8px; padding:11px 12px; background:#fff; }
.zv-camera .cam-contact-consent { display:flex; align-items:flex-start; gap:10px; cursor:pointer; }
.zv-camera .cam-contact-consent input { width:18px; height:18px; margin-top:2px; flex:none; accent-color:var(--indigo); }
.zv-camera .cam-contact-consent span { font-size:12.5px; font-weight:600; color:var(--muted); line-height:1.45; }
.zv-camera .cam-contact-consent a { color:var(--indigo); font-weight:800; }
.zv-camera .cam-contact button { font-family:inherit; font-size:14px; font-weight:800; color:#fff; background:var(--indigo); border:none; border-radius:8px; padding:12px 16px; cursor:pointer; }
.zv-camera .cam-contact-err { font-size:12px; font-weight:700; color:var(--red); display:none; }
.zv-camera .cam-contact-done { display:none; align-items:center; gap:8px; font-size:13px; font-weight:700; color:#2f8f5b; }
.zv-camera .cam-contact-done svg { width:16px; height:16px; flex:none; }

/* Niet gevonden wat u zocht? */
.zv-camera .ch-cta { padding-top:clamp(36px,4.4vw,56px); }
.zv-camera .ch-cta-in { display:flex; align-items:center; justify-content:space-between; gap:20px 32px; flex-wrap:wrap; background:var(--indigo); color:#fff; border-radius:20px; padding:clamp(22px,3vw,34px); }
.zv-camera .ch-cta-in > div:first-child { flex:1 1 380px; }
.zv-camera .ch-cta h2 { font-size:clamp(21px,2.4vw,28px); font-weight:900; letter-spacing:-.015em; line-height:1.15; margin:0; color:#fff; }
.zv-camera .ch-cta p { font-size:15px; font-weight:600; line-height:1.5; margin:8px 0 0; color:rgba(255,255,255,.82); max-width:620px; }
.zv-camera .ch-cta-actions { display:flex; flex-wrap:wrap; gap:10px; }

/* FAQ: the Veelgestelde vragen accordion (.fq-item), scoped here. */
.zv-camera .ch-faq { padding-top:clamp(36px,4.4vw,56px); padding-bottom:80px; }
.zv-camera .ch-faq > * { max-width:880px; }
.zv-camera .ch-faq h2 { font-size:clamp(21px,2.4vw,28px); font-weight:900; color:var(--indigo); letter-spacing:-.015em; line-height:1.15; margin:0 0 16px; }
.zv-camera .fq-item { background:var(--paper); border:1px solid var(--line); border-radius:14px; margin-bottom:10px; overflow:hidden; box-shadow:0 12px 30px -34px rgba(26,18,48,.5); }
.zv-camera .fq-q { width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px; text-align:left; font-family:inherit; background:none; border:none; padding:18px 20px; font-size:16px; font-weight:800; color:var(--indigo); line-height:1.35; cursor:pointer; }
.zv-camera .fq-q .pm { flex:none; width:26px; height:26px; border-radius:50%; background:var(--cream); color:var(--indigo); display:grid; place-items:center; transition:transform .2s,background .15s; }
.zv-camera .fq-q .pm svg { width:15px; height:15px; }
.zv-camera .fq-item.open .fq-q .pm { transform:rotate(45deg); background:var(--gold); }
.zv-camera .fq-a { max-height:0; overflow:hidden; transition:max-height .28s ease; }
.zv-camera .fq-a-in { padding:0 20px 20px; font-size:15px; font-weight:500; color:#5b5374; line-height:1.6; }
.zv-camera .fq-a-in a { font-weight:800; color:var(--indigo); }
.zv-camera .ch-faq-more { font-size:14px; font-weight:600; color:var(--muted); margin:16px 0 0; }
.zv-camera .ch-faq-more a { font-weight:800; color:var(--indigo); }
{% endstylesheet %}

