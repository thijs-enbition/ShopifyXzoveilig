  .zv-cart .cvcard .ci-thumb { width:40px; height:40px; border-radius:10px; }
  .zv-cart .cvcard .ci-thumb svg { width:20px; height:20px; }
  .zv-cart .cvcard .ci-name { font-size:15px; }
  .zv-cart .cvcard .ci-right { grid-column:auto; align-items:flex-end; text-align:right; margin-top:0; padding-top:0; border-top:none; }
