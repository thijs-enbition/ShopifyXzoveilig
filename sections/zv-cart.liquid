.zv-cart .cvtl-save { align-self:flex-start; margin-top:2px; font-size:13px; font-weight:800; color:#3a2a06; background:var(--gold-lt); border-radius:999px; padding:3px 11px; }
.zv-cart .cvtl-parts { margin:6px 0 0; display:flex; flex-direction:column; gap:3px; }
.zv-cart .cvtl-parts > div { display:flex; justify-content:space-between; gap:12px; font-size:13.5px; color:var(--indigo-soft); }
.zv-cart .cvtl-parts dt, .zv-cart .cvtl-parts dd { margin:0; }
.zv-cart .cvtl-parts dd { white-space:nowrap; font-weight:700; color:#fff; }
.zv-cart .ccost--dark .s-sub { margin:4px 0 0; }
.zv-cart .cinstall-hint { margin:0 0 12px; padding:10px 12px; border-radius:10px; background:#fdeccb; color:#5a3d00; text-align:left; }
.zv-cart .cinstall-hint a { color:inherit; }
@media(max-width:600px){
  .zv-cart .cvcard { padding:18px 16px; border-radius:16px; }
  .zv-cart .cv-head { flex-direction:column; align-items:flex-start; gap:6px; }
  .zv-cart .cv-head h2 { font-size:18px; }
  .zv-cart .cv-badge, .zv-cart .cv-hint, .zv-cart .cv-todo { margin-left:0; }
