.zv-cart .cinstall-price { grid-area:price; font-size:16px; }
.zv-cart .cinstall-opt:has(input:checked) { border-color:var(--gold); background:#fff6e2; }
.zv-cart .cinstall-opt:has(input:checked) .cinstall-icon { background:var(--indigo); color:#fff; }
.zv-cart .cinstall-summary { margin-top:10px; grid-template-columns:52px 1fr auto; }
.zv-cart .cinstall-summary .cinstall-icon { width:52px; height:52px; }
.zv-cart .cinstall-summary .ci-price { font-size:16px; }
.zv-cart .cinstall-cancel { grid-column:1 / -1; justify-self:start; }
/* Timeline */
.zv-cart .ccost--dark h2 { font-size:20px; margin-bottom:18px; }
.zv-cart .cvtl { list-style:none; margin:0; padding:0; }
.zv-cart .cvtl-step { position:relative; display:flex; flex-direction:column; gap:4px; padding:0 0 18px 28px; }
.zv-cart .cvtl-step::before { content:""; position:absolute; left:2px; top:5px; width:12px; height:12px; border-radius:50%; border:2px solid var(--gold); box-sizing:border-box; }
