.zv-cart .cinstall-options { display:flex; flex-direction:column; gap:12px; }
.zv-cart .cinstall-opt { display:grid; grid-template-columns:auto 64px 1fr auto; gap:16px; align-items:center; padding:16px; border:1.5px solid var(--line-2); border-radius:16px; cursor:pointer; }
