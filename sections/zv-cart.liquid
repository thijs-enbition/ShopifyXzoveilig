.zv-cart .cvcard .ci-price { font-size:16px; }
.zv-cart .cvtot { margin-top:14px; padding-top:14px; border-top:2px solid var(--indigo); display:flex; flex-direction:column; gap:6px; }
.zv-cart .cvtot > div { display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
.zv-cart .cvtot > .cvtot-calc { flex-direction:column; align-items:stretch; gap:4px; padding:6px 0 8px; border-bottom:1px dashed var(--line-2); }
.zv-cart .cvtot-calc > div { display:flex; justify-content:space-between; gap:12px; font-size:14px; font-weight:600; color:#5b5374; }
