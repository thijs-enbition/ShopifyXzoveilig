.zv-cart .cempty .ce-cta { display:flex; gap:13px; justify-content:center; flex-wrap:wrap; margin-top:28px; }
/* Layout 2026-11-03 (Robi): cards like Overzicht — installatie first, then Maandelijkse / Eenmalige kosten. */
.zv-cart .citems { background:none; border:none; box-shadow:none; overflow:visible; display:flex; flex-direction:column; gap:20px; }
.zv-cart .cvcard { background:var(--paper); border:1px solid var(--line); border-radius:20px; padding:24px; box-shadow:0 22px 52px -44px rgba(26,18,48,.5); }
.zv-cart .cv-head { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px; }
.zv-cart .cv-head h2 { margin:0; font-size:20px; font-weight:900; color:var(--indigo); letter-spacing:-.01em; }
.zv-cart .cv-badge { margin-left:auto; font-size:12.5px; font-weight:800; color:#5a3d00; background:#fdeccb; border-radius:999px; padding:5px 12px; }
.zv-cart .cv-hint { margin-left:auto; font-size:13.5px; font-weight:600; color:var(--muted); }
.zv-cart .cv-todo { margin-left:auto; font-size:13px; font-weight:800; color:var(--belt); }
.zv-cart .cvcard .citem { grid-template-columns:52px 1fr auto; gap:16px; padding:14px 0; border-bottom:1px solid var(--line); }
.zv-cart .cvcard .citem:last-of-type { border-bottom:1px solid var(--line); }
.zv-cart .cvcard .ci-thumb { width:52px; height:52px; border-radius:12px; }
