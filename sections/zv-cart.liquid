  .zv-cart .cinstall-section { padding:18px 16px; }
  .zv-cart .cinstall-opt { grid-template-columns:auto 1fr auto; grid-template-areas:"radio title price" "radio desc price"; }
  .zv-cart .cinstall-opt .cinstall-icon { display:none; }
  .zv-cart .cinstall-price { grid-column:auto; font-size:15px; }
  .zv-cart .cvtl-amt { font-size:26px; }
}
