.zv-cart .cvtot-main small { font-size:13px; font-weight:700; color:var(--muted); }
.zv-cart .cvtot-promo span, .zv-cart .cvtot-promo b { font-size:15px; font-weight:800; color:var(--indigo); }
.zv-cart .cvtot-promo b { white-space:nowrap; }
/* Installatie as the first card: options side by side */
.zv-cart .cinstall-section { padding:24px; border-top:1px solid var(--line); }
.zv-cart .cinstall-section--todo { border:2px solid var(--gold); }
.zv-cart .cinstall-options { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:10px; margin-top:10px; }
.zv-cart .cinstall-opt { grid-template-columns:auto 1fr; grid-template-areas:"radio icon" "title title" "desc desc" "price price"; gap:6px 10px; padding:14px; border-radius:14px; align-items:center; }
.zv-cart .cinstall-opt input { grid-area:radio; }
.zv-cart .cinstall-opt .cinstall-icon { grid-area:icon; width:40px; height:40px; border-radius:10px; justify-self:end; }
.zv-cart .cinstall-opt .cinstall-icon svg { width:22px; height:22px; }
.zv-cart .cinstall-title { grid-area:title; font-size:15px; line-height:1.3; }
