{%- comment -%}
  Langer Thuis landingspagina – Zo Veilig
  Plaats dit bestand in /sections en gebruik template page.langer-thuis.json.
  Alle CSS is afgeschermd met .zvlt zodat het theme niet wordt beïnvloed.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&display=swap" rel="stylesheet">

{%- comment -%}
  zv-pricing is INCLUDEd, not rendered: render is scope-isolated, so the zv_*_monthly strings it assigns
  would never reach this section. The package prices below come from it, never from section settings.
{%- endcomment -%}
{%- include 'zv-pricing' -%}
{%- assign tel_link = section.settings.phone | remove: ' ' | remove: '-' -%}

<style>
  .zvlt{--p:#322469;--pd:#1f1446;--g:#e4a311;--lav:#f7f5fb;--txt:#374151;--muted:#4b5563;
    font-family:'Titillium Web','Segoe UI',Arial,sans-serif;color:var(--txt);line-height:1.5}
  .zvlt *,.zvlt *::before,.zvlt *::after{box-sizing:border-box}
  .zvlt__wrap{max-width:1160px;margin:0 auto}
  .zvlt section{padding:72px 24px}
  .zvlt h1,.zvlt h2,.zvlt h3{font-family:inherit;font-weight:900;color:var(--p);margin:0;letter-spacing:0}
  .zvlt h2{font-size:clamp(1.9rem,4vw,2.4rem);line-height:1.1;margin-bottom:28px}
  .zvlt p{margin:0}
  .zvlt a{text-decoration:none}
  .zvlt__btn{display:inline-block;background:var(--g);color:var(--pd)!important;font-size:1.1rem;font-weight:700;padding:16px 26px;border-radius:10px;border:0;cursor:pointer;font-family:inherit;text-align:center}
  .zvlt__btn:hover{background:#f8a800}
  .zvlt__btn--ghost{background:transparent;color:#fff!important;border:2px solid #fff;padding:14px 24px}
  .zvlt__btn--ghost:hover{background:rgba(255,255,255,.1)}
  .zvlt__btn--dark{background:var(--p);color:#fff!important}
  .zvlt__btn--dark:hover{background:var(--pd)}

  /* Hero */
  .zvlt__hero{background:var(--p);border-top:8px solid var(--g);padding:60px 24px 64px!important}
  .zvlt__hero .zvlt__wrap{display:flex;flex-wrap:wrap;gap:40px;align-items:center}
  .zvlt__hero-text{flex:999 1 520px;min-width:0;display:flex;flex-direction:column;gap:20px}
  .zvlt__eyebrow{font-size:1rem;font-weight:700;color:var(--g);letter-spacing:2px;text-transform:uppercase}
  .zvlt__hero h1{font-size:clamp(2.3rem,5vw,4rem);line-height:1.02;color:#fff;text-wrap:balance}
  .zvlt__hero-sub{font-size:1.25rem;color:#e5e1f0;max-width:560px}
  .zvlt__btns{display:flex;flex-wrap:wrap;gap:14px}
  .zvlt__trust{display:flex;flex-wrap:wrap;gap:8px 24px;color:#d9d3ec;font-size:1rem}
  .zvlt__hero-img{flex:1 1 320px;display:flex;justify-content:center;min-width:0}

  /* Telefoon-mockup */
  .zvlt__phone{width:300px;border-radius:40px;background:#0f0b24;padding:11px;box-shadow:0 30px 60px rgba(0,0,0,.35)}
  .zvlt__screen{border-radius:30px;background:linear-gradient(180deg,#ece9f5,#f7f5fb);padding:44px 14px 18px;display:flex;flex-direction:column;gap:10px;min-height:520px}
  .zvlt__screen-title{font-weight:700;font-size:16px;color:var(--p);padding:0 4px 2px}
  .zvlt__card{background:#fff;border-radius:14px;padding:12px 14px;display:flex;gap:10px;align-items:center;box-shadow:0 6px 18px rgba(31,20,70,.16)}
  .zvlt__card-icon{width:34px;height:34px;border-radius:9px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
  .zvlt__card-body{flex:1;min-width:0}
  .zvlt__card-title{font-weight:700;font-size:14px;color:var(--p);line-height:1.2}
  .zvlt__card-sub{font-size:12.5px;color:var(--muted);line-height:1.3}
  .zvlt__card-time{font-size:11.5px;color:#6b7280;align-self:flex-start}
  .zvlt__rhythm{background:#fff;border-radius:14px;padding:12px 14px;box-shadow:0 6px 18px rgba(31,20,70,.16)}
  .zvlt__rhythm-head{display:flex;justify-content:space-between;align-items:center;gap:8px}
  .zvlt__badge{background:#e3f4ec;color:#1d7a50;font-weight:700;font-size:11px;padding:3px 8px;border-radius:999px;white-space:nowrap}
  .zvlt__bars{display:flex;align-items:flex-end;gap:3px;height:56px;margin:10px 0 6px}
  .zvlt__bars span{flex:1;background:var(--p);border-radius:3px}
  .zvlt__bars span.off{background:#c9c2de}
  .zvlt__axis{display:flex;justify-content:space-between;font-size:10.5px;color:#6b7280}

  /* Herkenning */
  .zvlt__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  .zvlt__recog{list-style:none;margin:0;padding:0}
  .zvlt__recog li{background:var(--lav);border-radius:14px;padding:20px;font-size:1.1rem;line-height:1.45;display:flex;gap:12px}
  .zvlt__dot{width:12px;height:12px;border-radius:50%;background:var(--g);flex-shrink:0;margin-top:8px}
  .zvlt__lead{margin-top:24px!important;font-size:1.2rem;font-weight:700;color:var(--p)}

  /* Stappen */
  .zvlt__steps-sec{background:var(--lav)}
  .zvlt__steps{list-style:none;margin:0;padding:0}
  .zvlt__steps li{background:#fff;border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:8px}
  .zvlt__num{width:48px;height:48px;border-radius:50%;background:var(--g);color:var(--pd);font-size:1.5rem;font-weight:900;display:flex;align-items:center;justify-content:center}
  .zvlt__step-title{font-size:1.2rem;font-weight:700;color:var(--p)}
  .zvlt__step-text{font-size:1.05rem}

  /* Pakketten */
  .zvlt__pk{background:#fff;border:1px solid #e5e1f0;border-radius:18px;padding:28px;display:flex;flex-direction:column;gap:12px}
  .zvlt__pk--hl{border:3px solid var(--g)}
  .zvlt__pk h3{font-size:1.8rem}
  .zvlt__price{font-size:2.5rem;font-weight:900;color:var(--p)}
  .zvlt__per{font-size:1rem;color:var(--muted)}
  .zvlt__pk p{flex:1;font-size:1.1rem}
  .zvlt__usp{margin-top:22px!important;font-size:1.15rem;font-weight:700;color:var(--p)}

  /* Waarom */
  .zvlt__why{background:var(--p)}
  .zvlt__why h2{color:#fff}
  .zvlt__why-item{border-top:4px solid var(--g);padding-top:14px}
  .zvlt__why-title{font-size:1.2rem;font-weight:700;color:#fff}
  .zvlt__why-text{font-size:1.05rem;color:#d9d3ec}

  /* FAQ */
  .zvlt__faq{display:flex;flex-direction:column;gap:12px;max-width:820px}
  .zvlt__faq details{background:var(--lav);border-radius:12px;padding:18px 22px}
  .zvlt__faq summary{font-size:1.12rem;font-weight:700;color:var(--p);cursor:pointer}
  .zvlt__faq details p{margin-top:10px;font-size:1.05rem}

  /* Formulier */
  .zvlt__form-sec{background:var(--lav)}
  .zvlt__form-sec .zvlt__wrap{display:flex;flex-wrap:wrap;gap:44px}
  .zvlt__form-intro{flex:999 1 380px;min-width:0;display:flex;flex-direction:column;gap:14px}
  .zvlt__form-intro h2{margin-bottom:0}
  .zvlt__form-intro p{font-size:1.15rem}
  .zvlt__form-intro a{font-weight:700;color:var(--p);text-decoration:underline}
  .zvlt__hours{font-size:1rem!important;color:var(--muted)}
  .zvlt__form{flex:1 1 360px;min-width:0;background:#fff;border-radius:18px;padding:28px;display:flex;flex-direction:column;gap:14px;box-shadow:0 10px 30px rgba(50,36,105,.12)}
  .zvlt__form label{display:flex;flex-direction:column;gap:6px;font-size:1rem;font-weight:700;color:var(--p)}
  .zvlt__form input,.zvlt__form select{width:100%;font-family:inherit;font-size:1.05rem;padding:14px 16px;border:1px solid #c9c2de;border-radius:10px;background:#fff;color:#1f2937}
  .zvlt__form input:focus,.zvlt__form select:focus{outline:2px solid var(--g);outline-offset:1px}
  .zvlt__privacy{font-size:.9rem;color:var(--muted)}
  .zvlt__msg{padding:12px 14px;border-radius:10px;font-weight:700}
  .zvlt__msg--ok{background:#e3f4ec;color:#1d7a50}
  .zvlt__msg--err{background:#fdecec;color:#b42318}

  /* Vaste adviesknop op mobiel */
  .zvlt__sticky{display:none}
  @media (max-width:640px){
    .zvlt section{padding:48px 18px}
    .zvlt__hero-img{display:none}
    .zvlt__steps li,.zvlt__pk{padding:20px}
    .zvlt__sticky{display:block;position:sticky;bottom:0;z-index:20;background:#fff;padding:12px 16px;box-shadow:0 -6px 20px rgba(31,20,70,.15)}
    .zvlt__sticky .zvlt__btn{display:block}
  }
</style>

<div class="zvlt" id="zvlt-{{ section.id }}">

  <!-- HERO -->
  <section class="zvlt__hero">
    <div class="zvlt__wrap">
      <div class="zvlt__hero-text">
        <div class="zvlt__eyebrow">{{ section.settings.eyebrow }}</div>
        <h1>{{ section.settings.hero_title }}</h1>
        <p class="zvlt__hero-sub">{{ section.settings.hero_text }}</p>
        <div class="zvlt__btns">
          <a href="#zvlt-aanvraag" class="zvlt__btn">{{ section.settings.cta_label }}</a>
          <a href="#zvlt-pakketten" class="zvlt__btn zvlt__btn--ghost">Bekijk de pakketten</a>
        </div>
        <div class="zvlt__trust"><span>Securitas Preferred Partner</span><span>Eigen monteurs</span><span>Persoonlijk advies</span></div>
      </div>
      <div class="zvlt__hero-img" aria-hidden="true">
        <div class="zvlt__phone">
          <div class="zvlt__screen">
            <div class="zvlt__screen-title">Langer Thuis · Mam</div>
            <div class="zvlt__card">
              <div class="zvlt__card-icon" style="background:#2f9e6b">
                <svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="none" stroke="#fff" stroke-width="2"/><path d="M12 3V5M12 19V21M3 12H5M19 12H21M5.6 5.6L7 7M17 17L18.4 18.4M5.6 18.4L7 17M17 7L18.4 5.6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div class="zvlt__card-body"><div class="zvlt__card-title">Ochtendactiviteit</div><div class="zvlt__card-sub">Mam is actief, zoals gebruikelijk</div></div>
              <div class="zvlt__card-time">07:45</div>
            </div>
            <div class="zvlt__rhythm">
              <div class="zvlt__rhythm-head"><div class="zvlt__card-title">Leefritme vandaag</div><span class="zvlt__badge">Zoals gebruikelijk</span></div>
              <div class="zvlt__bars">
                <span class="off" style="height:10%"></span><span class="off" style="height:8%"></span><span class="off" style="height:7%"></span><span class="off" style="height:8%"></span>
                <span style="height:40%"></span><span style="height:85%"></span><span style="height:65%"></span><span style="height:75%"></span><span style="height:55%"></span><span style="height:70%"></span>
                <span style="height:80%"></span><span style="height:60%"></span><span style="height:68%"></span><span style="height:52%"></span><span style="height:40%"></span><span style="height:30%"></span>
                <span class="off" style="height:13%"></span><span class="off" style="height:8%"></span>
              </div>
              <div class="zvlt__axis"><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div>
            </div>
            <div class="zvlt__card">
              <div class="zvlt__card-icon" style="background:#322469">
                <svg width="20" height="20" viewBox="0 0 24 24"><path d="M3 11 L12 4 L21 11 V20 H3 Z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"/></svg>
              </div>
              <div class="zvlt__card-body"><div class="zvlt__card-title">Geen bijzonderheden</div><div class="zvlt__card-sub">Het ritme verloopt zoals normaal</div></div>
              <div class="zvlt__card-time">14:00</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HERKENNING -->
  <section>
    <div class="zvlt__wrap">
      <h2>Herkent u dit?</h2>
      <ul class="zvlt__recog zvlt__grid">
        <li><span class="zvlt__dot"></span>U belt weleens alleen om te horen of alles goed gaat.</li>
        <li><span class="zvlt__dot"></span>U woont niet om de hoek en kunt niet steeds langskomen.</li>
        <li><span class="zvlt__dot"></span>Uw dierbare wil zelfstandig blijven, maar u maakt zich soms zorgen.</li>
        <li><span class="zvlt__dot"></span>Een camera in huis voelt voor niemand prettig.</li>
      </ul>
      <p class="zvlt__lead">Langer Thuis geeft u rust, zonder dat er voor uw dierbare veel verandert.</p>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="zvlt__steps-sec">
    <div class="zvlt__wrap">
      <h2>Zo werkt het</h2>
      <ol class="zvlt__steps zvlt__grid">
        <li><span class="zvlt__num">1</span><span class="zvlt__step-title">Kies uw zekerheid</span><span class="zvlt__step-text">Doe de keuzehulp of laat u adviseren.</span></li>
        <li><span class="zvlt__num">2</span><span class="zvlt__step-title">Slimme sensoren in huis</span><span class="zvlt__step-text">Onze eigen monteurs zorgen voor een goede installatie.</span></li>
        <li><span class="zvlt__num">3</span><span class="zvlt__step-title">Inzicht in het leefritme</span><span class="zvlt__step-text">Zoals ochtendactiviteit, beweging en dagelijkse gewoonten.</span></li>
        <li><span class="zvlt__num">4</span><span class="zvlt__step-title">U krijgt een seintje</span><span class="zvlt__step-text">Bij ingestelde afwijkingen ontvangt u een melding in de app.</span></li>
      </ol>
    </div>
  </section>

  <!-- PAKKETTEN -->
  <section id="zvlt-pakketten">
    <div class="zvlt__wrap">
      <h2>Kies de zekerheid die bij u past</h2>
      <div class="zvlt__grid">
        <div class="zvlt__pk">
          <h3>Inzicht</h3>
          <div><span class="zvlt__price">{{ zv_inzicht_monthly }}</span> <span class="zvlt__per">per maand</span></div>
          <p>Inzicht in het dagelijks leefritme.</p>
          <a href="#zvlt-aanvraag" class="zvlt__btn zvlt__btn--dark" data-zvlt-pakket="Inzicht">Advies over Inzicht</a>
        </div>
        <div class="zvlt__pk">
          <h3>Zeker</h3>
          <div><span class="zvlt__price">{{ zv_zeker_monthly }}</span> <span class="zvlt__per">per maand</span></div>
          <p>Alles van Inzicht, plus inzicht in slaap, rust en activiteiten per ruimte.</p>
          <a href="#zvlt-aanvraag" class="zvlt__btn zvlt__btn--dark" data-zvlt-pakket="Zeker">Advies over Zeker</a>
        </div>
        <div class="zvlt__pk zvlt__pk--hl">
          <h3>Beschermd</h3>
          <div><span class="zvlt__price">{{ zv_beschermd_monthly }}</span> <span class="zvlt__per">per maand</span></div>
          <p>24/7 meldkamer, noodknop en bescherming tegen rook en brand.</p>
          <a href="#zvlt-aanvraag" class="zvlt__btn" data-zvlt-pakket="Beschermd">Advies over Beschermd</a>
        </div>
      </div>
      <p class="zvlt__usp">Geen camera’s. Wel persoonlijke service en eigen monteurs.</p>
      <div style="margin-top:22px"><a href="#zvlt-aanvraag" class="zvlt__btn">{{ section.settings.cta_label }}</a></div>
    </div>
  </section>

  <!-- WAAROM -->
  <section class="zvlt__why">
    <div class="zvlt__wrap">
      <h2>Waarom Zo Veilig</h2>
      <div class="zvlt__grid">
        <div class="zvlt__why-item"><div class="zvlt__why-title">Ruim 10 jaar ervaring</div><div class="zvlt__why-text">in veiligheid in en om huis.</div></div>
        <div class="zvlt__why-item"><div class="zvlt__why-title">Securitas Preferred Partner</div><div class="zvlt__why-text">meldingen worden opgevolgd door een professionele meldkamer.</div></div>
        <div class="zvlt__why-item"><div class="zvlt__why-title">Eigen monteurs</div><div class="zvlt__why-text">zorgen voor een goede installatie.</div></div>
        <div class="zvlt__why-item"><div class="zvlt__why-title">Persoonlijk contact</div><div class="zvlt__why-text">u spreekt met mensen die u kennen.</div></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="zvlt__wrap">
      <h2>Veelgestelde vragen</h2>
      <div class="zvlt__faq">
        <details><summary>Kijken de sensoren mee?</summary><p>Nee. Er zitten geen camera’s in het pakket. De sensoren geven inzicht in beweging en activiteit in huis, met respect voor privacy.</p></details>
        <details><summary>Moet mijn dierbare iets met een app of telefoon doen?</summary><p>Nee. De meldingen komen bij u of andere familieleden binnen. Uw dierbare hoeft niets te bedienen.</p></details>
        <details><summary>Wie installeert de sensoren?</summary><p>Onze eigen monteurs zorgen voor een goede installatie en leggen alles rustig uit.</p></details>
        <details><summary>Wat gebeurt er als er iets afwijkt?</summary><p>Bij Inzicht en Zeker krijgt u een melding in de app. Bij Beschermd gaat een alarm naar de 24/7 meldkamer, die de opvolging regelt.</p></details>
        <details><summary>Kan ik later uitbreiden of overstappen?</summary><p>Ja. U kunt overstappen naar een uitgebreider pakket. Wij adviseren u graag.</p></details>
      </div>
    </div>
  </section>

  <!-- FORMULIER -->
  <section class="zvlt__form-sec" id="zvlt-aanvraag">
    <div class="zvlt__wrap">
      <div class="zvlt__form-intro">
        <h2>Benieuwd wat bij uw situatie past?</h2>
        <p>Laat uw gegevens achter. Wij nemen contact met u op voor een vrijblijvend adviesgesprek.</p>
        <p>Liever zelf bellen? <a href="tel:{{ tel_link }}">{{ section.settings.phone }}</a></p>
        <p class="zvlt__hours">{{ section.settings.hours }}</p>
      </div>

      {%- form 'contact', class: 'zvlt__form', id: 'zvlt-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="zvlt__msg zvlt__msg--ok" role="status">Dank u wel! Wij nemen zo snel mogelijk contact met u op.</div>
        {%- elsif form.errors -%}
          <div class="zvlt__msg zvlt__msg--err" role="alert">Controleer of alle verplichte velden goed zijn ingevuld.</div>
        {%- endif -%}
        <input type="hidden" name="contact[Aanvraag]" value="Langer Thuis – adviesaanvraag landingspagina">
        <input type="hidden" name="contact[Pakket]" id="zvlt-pakket" value="">
        <label for="zvlt-naam">Naam
          <input type="text" id="zvlt-naam" name="contact[name]" autocomplete="name" required>
        </label>
        <label for="zvlt-tel">Telefoonnummer
          <input type="tel" id="zvlt-tel" name="contact[phone]" autocomplete="tel" required>
        </label>
        <label for="zvlt-mail">E-mail
          <input type="email" id="zvlt-mail" name="contact[email]" autocomplete="email" required>
        </label>
        <label for="zvlt-voor">Voor wie zoekt u een oplossing?
          <select id="zvlt-voor" name="contact[Voor wie]">
            <option>Mijn partner</option>
            <option>Een familielid</option>
            <option>Voor mezelf</option>
            <option>Iemand anders</option>
          </select>
        </label>
        <button type="submit" class="zvlt__btn">{{ section.settings.cta_label }}</button>
        <p class="zvlt__privacy">Wij gebruiken uw gegevens alleen om contact met u op te nemen over uw adviesaanvraag.</p>
      {%- endform -%}
    </div>
  </section>

  <div class="zvlt__sticky"><a href="#zvlt-aanvraag" class="zvlt__btn">{{ section.settings.cta_label }}</a></div>
</div>

<script>
  (function () {
    var root = document.getElementById('zvlt-{{ section.id }}');
    if (!root) return;
    var field = root.querySelector('#zvlt-pakket');
    root.querySelectorAll('[data-zvlt-pakket]').forEach(function (btn) {
      btn.addEventListener('click', function () { if (field) field.value = btn.getAttribute('data-zvlt-pakket'); });
    });
  })();
</script>

{% schema %}
{
  "name": "Langer Thuis landing",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label boven titel", "default": "Langer Thuis" },
    { "type": "text", "id": "hero_title", "label": "Titel", "default": "Langer zelfstandig thuis. Met een gerust gevoel." },
    { "type": "textarea", "id": "hero_text", "label": "Introtekst", "default": "Slimme sensoren geven inzicht in het leefritme van uw dierbare. Bij afwijkingen krijgt u een seintje. Zonder camera’s." },
    { "type": "text", "id": "cta_label", "label": "Tekst adviesknop", "default": "Vraag vrijblijvend advies aan" },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "phone", "label": "Telefoonnummer", "default": "088-122 11 11" },
    { "type": "text", "id": "hours", "label": "Openingstijden", "default": "Ma t/m do 08:30–17:00 · vr 08:30–13:00" }
  ],
  "presets": [ { "name": "Langer Thuis landing" } ]
}
{% endschema %}