{%- comment -%}
  GENERATED FILE. Do not edit by hand.
  Source: pricing/pricing.config.json (lines[].packages[].productHandle / sku)
  Rebuild: python3 scripts/build_pricing.py
  Usage: capture the output of: render 'zv-package-handles', line: 'langer-thuis', what: 'handles'
  line: a pricing.config.json line id, or 'all'; what: 'handles' (default), 'skus' or 'name'.
  Pipe-separated, in display order. Packages are looked up with all_products[handle],
  never from a tagged collection (fix/packages-by-handle, 2026-09-24).
{%- endcomment -%}
{%- liquid
  case line
    when 'langer-thuis'
      if what == 'skus'
        echo 'A0071|A0072|LT-BES'
      elsif what == 'name'
        echo 'Langer Thuis'
      else
        echo 'nami-langer-thuis-inzicht|nami-langer-thuis-zeker|langer-thuis-beschermd'
      endif
    when 'mijn-thuis'
      if what == 'skus'
        echo 'A0073|MT-PRO|MT-VIS'
      elsif what == 'name'
        echo 'Mijn Thuis'
      else
        echo 'nami-mijn-thuis-alert|mijn-thuis-protect|mijn-thuis-vista'
      endif
    when 'veilig-onderweg'
      if what == 'skus'
        echo 'VO-SOLO|VO-GUARD'
      elsif what == 'name'
        echo 'Veilig Onderweg'
      else
        echo 'veilig-onderweg-paniek-meldkamer|veilig-onderweg-zorgmeldkamer'
      endif
    when 'woning'
      if what == 'skus'
        echo 'N0008|E001'
      elsif what == 'name'
        echo 'Woning'
      else
        echo 'extra-etage-of-100m2|extra-etage-of-100m2-climax'
      endif
    when 'rider'
      if what == 'skus'
        echo 'A102B'
      elsif what == 'name'
        echo ''
      else
        echo 'camera-abonnement-videodeurbel-1200-clips'
      endif
    when 'ontzorg'
      if what == 'skus'
        echo 'MOIOH|MOZOH|OHC012|MOAOH'
      elsif what == 'name'
        echo 'Ontzorgpakket'
      else
        echo 'maandelijks-ontzorg-inzicht-oh|maandelijks-ontzorg-zeker-oh|maandelijks-onderhoud-alarmsysteem|maandelijks-ontzorg-alert-oh'
      endif
    when 'all'
      if what == 'skus'
        echo 'A0071|A0072|LT-BES|A0073|MT-PRO|MT-VIS|VO-SOLO|VO-GUARD'
      elsif what == 'name'
        echo ''
      else
        echo 'nami-langer-thuis-inzicht|nami-langer-thuis-zeker|langer-thuis-beschermd|nami-mijn-thuis-alert|mijn-thuis-protect|mijn-thuis-vista|veilig-onderweg-paniek-meldkamer|veilig-onderweg-zorgmeldkamer'
      endif
  endcase
-%}
