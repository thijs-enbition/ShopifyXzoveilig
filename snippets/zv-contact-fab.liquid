{%- comment -%}
  Floating contact button (ticket S-02). Rendered once, from layout/theme.liquid only
  (never layout/password.liquid). Styles: assets/zv-contact-fab.css. Behaviour:
  assets/zv-contact-fab.js (toggle, Escape, outside click).

  Placement: bottom-LEFT, so it never collides with Lio (snippets/zv-lio.liquid), which
  pops up bottom-right. z-index 40 keeps it below the sticky header group (z-index 50),
  so the full-screen mobile nav drawer (inside that stacking context) covers it, and below
  the Oplossingen modal/cart drawer (9999/10000) and Shopify's cookie banner.
{%- endcomment -%}
<div class="zv-fab" data-zv-fab>
  <button
    type="button"
    class="zv-fab__toggle"
    data-zv-fab-toggle
    aria-expanded="false"
    aria-controls="zv-fab-panel"
    aria-label="Hoe kunnen wij u helpen?"
  >
    <svg class="zv-fab__icon zv-fab__icon--open" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    <svg class="zv-fab__icon zv-fab__icon--close" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    <span class="zv-fab__label">Hoe kunnen wij u helpen?</span>
  </button>
  <div class="zv-fab__panel" id="zv-fab-panel" data-zv-fab-panel hidden>
    <p class="zv-fab__title">Neem contact met ons op</p>
    <ul class="zv-fab__list">
      <li>
        <a class="zv-fab__link" href="tel:0881221111">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 14l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          <span>Bel 088 122 11 11</span>
        </a>
      </li>
      <li>
        <a class="zv-fab__link" href="mailto:klantenservice@zoveilig.nl">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          <span>Mail ons</span>
        </a>
      </li>
      <li>
        <a class="zv-fab__link" href="{% render 'zv-route', key: 'contact' %}">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Plan een adviesgesprek</span>
        </a>
      </li>
    </ul>
  </div>
</div>
